##############################################################################
# Indoor Wayfinding — Root .gitignore
# Covers backend/ (Spring Boot) and frontend/ (React + Vite)
##############################################################################

# ----------------------------------------------------------------------------
# Java / Maven (backend build output)
# ----------------------------------------------------------------------------
target/
build/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ----------------------------------------------------------------------------
# Node / npm / Vite (frontend build output)
# ----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------------------------------------------
# Environment & secrets
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.env.local
*.env.production.local
*.env.development.local

application-local.yml
application-local.yaml
application-local.properties

*.jks
*.p12
*.pfx
*.keystore
*.pem
*.key
*.crt
*.cer

# ----------------------------------------------------------------------------
# IDE — IntelliJ IDEA
# ----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# IDE — Eclipse
.classpath
.project
.settings/
.metadata/

# IDE — VS Code (workspace files only)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# ----------------------------------------------------------------------------
# OS files
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------------------------------------------------
# Logs & runtime
# ----------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock
*.out

# ----------------------------------------------------------------------------
# Test / coverage
# ----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
surefire-reports/
failsafe-reports/
test-output/

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
temp/
tmp/
*.bak
*.orig
*.rej

# Local DB dumps / files (never commit real DBs)
*.sqlite
*.sqlite3
*.db
*.dump